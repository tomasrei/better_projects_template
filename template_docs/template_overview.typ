#import "flowlib.typ": *

#show: fc-doc.with(
  title: [How this template works],
  subtitle: [From raw data to a finished PDF: R does the computing, Typst only typesets],
  lang: "en",
)

// ---------- Layer 1: overview ----------

// Folder frame: same look as fc-group, but with a configurable inset, so the
// folder frames can sit tightly inside the project frame. The label is moved
// up by the extra inset so it always sits on the frame line.
#let folder-frame(enclose, label, inset: 6pt) = node(
  enclose: enclose, stroke: (paint: border, thickness: 0.8pt, dash: "dashed"),
  fill: none, corner-radius: 5pt, inset: inset, snap: false,
  // place() gives the label zero size, so it can't widen the grid column the
  // frame's centre falls in.
  place(top + left, dx: 10pt - inset, dy: 10pt - inset - 1.2em, box(fill: white, inset: (x: 3pt))[
    #text(size: 7.5pt, weight: "bold", fill: muted, raw(label))]),
)

// JSON icon: a page with a small JSON snippet (flowlib has no JSON icon).
// raw() keeps the quotes straight. Same size as fc-icon-doc.
#let icon-json(w: 1.6cm, h: 2.05cm, color: brand) = box(width: w, height: h)[
  #place(top+left, rect(width: w, height: h, radius: 3pt, fill: white, stroke: 1.1pt + color))
  #place(top+left, dx: w * 0.1, dy: h * 0.07, {
    set text(fill: color, size: 4.8pt)
    set par(leading: 0.42em)
    raw("{\n \"n\": 32,\n \"mean\": 4.1,\n \"sd\": 1.2,\n \"min\": 1.5,\n \"max\": 7.9,\n \"year\": 2024\n}")
  })
]

// Combined figure (candidate to replace both the old overview and the full chain).
// Rows: lookups + functions.R (read only) on top, the main data -> script chain,
// then output/ and typst/. Dotted lines = read only.
#align(center, scale(80%, reflow: true, fc-diagram(
  spacing: (1.4cm, 1.3cm),
  fc-file((0, 0), [Metadata], sub: [`data/misc/metadata.xlsx`], icon: fc-icon-sheet, name: <misc>),
  fc-file((2, 0), [Functions], sub: [`scripts/functions.R`], icon: fc-icon-doc.with(tag: "R"), name: <fn>),
  fc-file((0, 1), [Raw data], sub: [`data/raw/`], icon: fc-icon-folder, kind: "ext", name: <raw>),
  fc-file((1, 1), [Clean], sub: [`scripts/*_clean.R`], icon: fc-icon-doc.with(tag: "R"), kind: "run", name: <clean>),
  fc-file((2, 1), [Clean data], sub: [`data/clean/`], icon: fc-icon-folder, kind: "gen", name: <rds>),
  fc-file((3, 1), [Analyse], sub: [`scripts/*_analyse_*.R`], icon: fc-icon-doc.with(tag: "R"), kind: "run", name: <analyse>),
  fc-file((1, 2), [Plots], sub: box(inset: (bottom: 4pt))[`output/plots/`], icon: fc-icon-docs.with(tag: "PNG"), kind: "gen", name: <plots>, outset: 0pt),
  fc-file((2, 2), [Tables], sub: box(inset: (bottom: 4pt))[`output/tables/`], icon: fc-icon-docs.with(tag: "TYP"), kind: "gen", name: <tables>, outset: 0pt),
  fc-file((3, 2), [Numbers], sub: box(inset: (bottom: 4pt))[`output/data.json`], icon: icon-json, kind: "gen", name: <json>, outset: 0pt),
  fc-file((2, 3), [Text], sub: [`typst/main.typ`], icon: fc-icon-doc.with(tag: "TYP"), name: <typ>, outset: 0pt),
  fc-file((3, 3), [Report], sub: [`typst/main.pdf`], icon: fc-icon-doc.with(tag: "PDF"), kind: "out", name: <pdf>),

  // read-only inputs: lookups and functions.R both feed down into Clean (shared
  // trunk); functions.R also feeds Analyse
  fc-reads(<misc>, (1, 0), <clean>),
  fc-reads(<fn>, (1, 0), <clean>),
  fc-reads(<fn>, (3, 0), <analyse>),

  fc-flow(<raw>, <clean>),
  fc-flow(<clean>, <rds>),
  fc-flow(<rds>, <analyse>),
  fc-flow(<analyse>, (3, 1.5), (1, 1.5), <plots>),
  fc-flow(<analyse>, (3, 1.5), (2, 1.5), <tables>),
  fc-flow(<analyse>, <json>),
  fc-flow(<plots>, (1, 2.5), (2, 2.5), <typ>),
  fc-flow(<tables>, <typ>),
  fc-flow(<json>, (3, 2.5), (2, 2.5), <typ>),
  fc-flow(<typ>, <pdf>, [compile], label-side: left),

  // Project folder frame. The folder of each item is in its caption.
  folder-frame((<misc>, <fn>, <raw>, <clean>, <rds>, <analyse>, <plots>, <tables>, <json>, <typ>, <pdf>),
    "project_folder_name/", inset: 16pt),
)))


#v(0.4cm)

#fc-steps(
  ([Add data], [Put the original files in `data/raw/` and never touch them again.
    Lookups and crosswalks go in `data/misc/metadata.xlsx`.]),
  ([Clean], [Write and run `{dataset}_clean.R`. It saves one
    `data/clean/{dataset}.rds` and does nothing else.]),
  ([Analyse], [Run `{dataset}_analyse_{topic}.R`. It reads the `.rds` and writes
    plots, tables and inline numbers into `output/`.]),
  ([Write & compile], [Write the text in `typst/main.typ`, which pulls in the plots,
    tables and numbers. Preview and export it in Positron or VS Code. Compiling is
    instant: nothing is computed.]),
)

#v(0.4cm)
#line(length: 100%, stroke: 0.5pt + border)
#text(size: 9pt, fill: gray.darken(20%))[
  *Script names:* `{dataset}_{role}.R`, e.g. `cars_clean.R` and `cars_analyse_weight.R`.
  The `*` in the figure stands for the dataset name. Because the dataset comes first, all
  scripts for one dataset sit next to each other in the file list. No number prefixes
  (`01_`, `02_`): the role says the order (clean before analyse). Alphabetically,
  `analyse` lands above `clean`, but the group stays together.
]

#pagebreak()

// ---------- Layer 3: reference ----------

= Folder structure

`{dataset}` and `{topic}` are placeholders: e.g. `occupation_clean.R`,
`occupation_analyse_wages.R`. The `mtcars_*` files in the template are demos.

#v(0.2cm)
// The tree is drawn without kind badges (edit/run/generated...): every entry is
// passed as kind "dir", which gives no badge and one plain colour.
#let plain-tree(root, entries) = fc-tree(root, entries.map(e => {
  let e = e
  e.insert("kind", "dir")
  e
}))

#plain-tree("better_projects_template/", (
  (name: "data/", kind: "dir", note: [All data. Contents git-ignored; `.gitkeep` keeps the empty folders.]),
  (name: "raw/", depth: 1, kind: "ext", note: [Original data as received. *Never modified.* Often too sensitive or large for GitHub.]),
  (name: "clean/", depth: 1, kind: "gen", note: [One `.rds` per dataset, written by its clean script.]),
  (name: "misc/", depth: 1, kind: "src", note: [`metadata.xlsx`: crosswalks, lookups (one sheet each). R reads, never writes.]),
  (name: "scripts/", kind: "dir", note: [All code. Always committed.]),
  (name: "functions.R", depth: 1, kind: "src", note: [Project functions (`f_` prefix). Every script sources it at the top.]),
  (name: "{dataset}_clean.R", depth: 1, kind: "run", note: [One per dataset. Raw → `data/clean/`. Nothing downstream.]),
  (name: "{dataset}_analyse_{topic}.R", depth: 1, kind: "run", note: [One or more per dataset. `data/clean/` → `output/`.]),
  (name: "main.R", depth: 1, note: [Currently a one-file mtcars/tinytrail demo. Its role is *undecided*.]),
  (name: "output/", kind: "dir", note: [Everything R produces for the report. Contents git-ignored.]),
  (name: "plots/", depth: 1, kind: "gen", note: [PNG/SVG from `ggsave()`.]),
  (name: "tables/", depth: 1, kind: "gen", note: [Typst snippets or CSV, included in `main.typ`.]),
  (name: "data.json", depth: 1, kind: "gen", note: [Inline numbers, read with `json()`.]),
  (name: "typst/", kind: "dir", note: [The document. Typst reads `output/`, never writes to it.]),
  (name: "main.typ", depth: 1, kind: "src", note: [The text. Path variables (`plots`, `tables`, `data`) at the top.]),
  (name: "main.pdf", depth: 1, kind: "out", note: [The finished report.]),
  (name: "template_docs/", kind: "dir", note: [How to use the template.]),
  (name: "Template manual.md", depth: 1, kind: "src", note: [Conventions, how to run, adding a dataset.]),
  (name: "How to write a function.md", depth: 1, kind: "src", note: [Style guide for `functions.R`.]),
  (name: "template_overview.pdf", depth: 1, kind: "out", note: [This document (source `.typ` + `flowlib.typ`).]),
  (name: "99_working_notes/", kind: "dir", note: [Notes about the actual project, not the template.]),
  (name: "daily_log.md", depth: 1, kind: "src", note: [What you did, found and decided. Newest entry on top.]),
  (name: "_tinytrail.yaml", kind: "gen", note: [Provenance log, updated by `tinytrail()`.]),
  (name: ".gitignore", kind: "src", note: [Keeps data and generated files out of git.]),
))

#v(0.3cm)
*In git:* scripts, `typst/main.typ`, `template_docs/` and folder skeletons. *Not in git:* everything in
`data/`, everything R generates, `_tinytrail.yaml` and all PDFs. A collaborator clones the
repo and re-runs the scripts to regenerate the rest. How to run them, naming conventions
and adding a new dataset: see `template_docs/Template manual.md`.

#v(0.3cm)
#fc-box([Good to know], [
  - *Generated files are overwritten* on every run: `data/clean/`, `output/plots/`,
    `output/tables/`, `output/data.json`. Change the script, never the output.
  - *`data.json` is shared* by all analysis scripts. Each merges in its own numbers
    under its dataset's key (see the manual).
  - *Open the project folder* in Positron or VS Code, so the preview can read `output/`.
  - *Order:* clean, analyse, compile. Each script run also updates `_tinytrail.yaml`.
])
